{
  "manifest_version": 3,
  "name": "GHL Page Compiler",
  "version": "1.0.0",
  "description": "Translate HTML into GHL page elements and inject directly into the page builder.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": [
    "https://*.gohighlevel.com/*",
    "https://*.highlevel.com/*",
    "https://*.leadconnectorhq.com/*"
  ],
  "action": {
    "default_title": "Open GHL Compiler"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gohighlevel.com/*",
        "https://*.highlevel.com/*",
        "https://*.leadconnectorhq.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
