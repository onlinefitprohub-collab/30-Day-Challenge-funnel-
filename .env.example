# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic (required for AI generation — without this, mock mode is used)
ANTHROPIC_API_KEY=your_anthropic_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (comma-separated emails that can delete funnels and create folders)
ADMIN_EMAIL=your_admin_email@example.com

# Stripe (required for billing)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID from your Stripe dashboard (Products → Pro Plan → Price ID)
STRIPE_PRO_PRICE_ID=price_xxx
