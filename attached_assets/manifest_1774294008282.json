{
  "manifest_version": 3,
  "name": "CloneLevel",
  "version": "0.2.0",
  "description": "Clone any public funnel or HighLevel page — one-click capture, asset scraping, and seamless import into the HighLevel page builder.",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "debugger", "webNavigation", "webRequest", "cookies"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "content/bridge/page-bridge-runtime.js",
        "content/bridge/page-bridge-runtime.js.map",
        "content/clonelevel-inject.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
