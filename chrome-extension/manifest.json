{
  "manifest_version": 3,
  "name": "Challenge Funnel in a Box",
  "short_name": "CF Funnel",
  "version": "2.6.0",
  "description": "Copy any public GHL page, then paste it into your GHL builder. Uses GHL's own clone-funnel-step API. No API key needed.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CF Funnel",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.gohighlevel.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.gohighlevel.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.replit.dev/*",
        "https://*.replit.app/*",
        "https://*.replit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://app.gohighlevel.com/*",
    "https://*.leadconnectorhq.com/*",
    "https://*.replit.dev/*",
    "https://*.replit.app/*",
    "https://*.replit.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["https://app.gohighlevel.com/*"]
    }
  ]
}
