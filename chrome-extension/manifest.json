{
  "manifest_version": 3,
  "name": "Challenge Funnel in a Box",
  "short_name": "CF Funnel",
  "version": "2.0.0",
  "description": "Open on your results page to save your funnel, then inject native pages into HighLevel's builder with one click.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CF Funnel",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.gohighlevel.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://app.gohighlevel.com/*",
    "https://backend.leadconnectorhq.com/*",
    "https://*.replit.dev/*",
    "https://*.replit.app/*",
    "https://*.replit.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["https://app.gohighlevel.com/*"]
    }
  ]
}
